#=======================================
# Physical Constraints file / Pinout
# HDMI igrica + I2C (ADS1115) + dzojstik (SAMO Y osa, pojednostavljeno)
#=======================================

#___Inputs
IO_LOC  "clk_ext" 52;
IO_PORT "clk_ext" PULL_MODE=UP  IO_TYPE=LVCMOS33 ;

# Fizicko dugme S1 -- ISTI pin i podesavanja kao u LV4 (dokazano radi).
# NE MORA se pritiskati -- vidjeti komentar na vrhu top.sv.
IO_LOC  "areset_n" 4;
IO_PORT "areset_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

#___I2C (ADS1115 -- dzojstik, Y osa na A0)
# ISTI pinovi kao u LV4 (potenciometar); slobodni GPIO, FPGA nema
# namjensku hardversku I2C perifernu jedinicu.
IO_LOC  "i2c_sda" 31;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33;
IO_LOC  "i2c_scl" 32;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33;

#___Outputs
IO_LOC  "led_n" 11;
IO_PORT "led_n" PULL_MODE=UP DRIVE=8;

IO_LOC  "led_hit_n" 10;
IO_PORT "led_hit_n" PULL_MODE=UP DRIVE=8;

#___Dijagnosticke diode (privremeno -- ukloniti kad se potvrdi da radi)
IO_LOC  "led_dbg_n[0]" 13;
IO_PORT "led_dbg_n[0]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led_dbg_n[1]" 14;
IO_PORT "led_dbg_n[1]" PULL_MODE=UP DRIVE=8;
IO_LOC  "led_dbg_n[2]" 15;
IO_PORT "led_dbg_n[2]" PULL_MODE=UP DRIVE=8;


IO_LOC  "hdmi_clk_p"    69,68;
IO_PORT "hdmi_clk_p"    PULL_MODE=NONE DRIVE=8;
IO_LOC  "hdmi_dat_p[0]" 71,70;
IO_PORT "hdmi_dat_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC  "hdmi_dat_p[1]" 73,72;
IO_PORT "hdmi_dat_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC  "hdmi_dat_p[2]" 75,74;
IO_PORT "hdmi_dat_p[2]" PULL_MODE=NONE DRIVE=8;

#___End-of-File
